# Cerebras (required for visualizations; without it the proxy is a passthrough)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=zai-glm-4.7
CEREBRAS_TEMPERATURE=0.2
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Upstream MCP server. Defaults are correct for origin-staging; override only
# if pointing at a different deployment.
ORIGIN_STAGING_URL=https://mcp.staging.originhq.com/mcp
ORIGIN_STAGING_SERVER_NAME=origin-staging

# Token resolution: by default the proxy reads ~/.claude/.credentials.json
# (the Claude Code OAuth store) and re-reads on every call so refreshes flow
# through. Set ORIGIN_STAGING_TOKEN to override with a static bearer.
# CLAUDE_CREDENTIALS_PATH=/home/you/.claude/.credentials.json
# ORIGIN_STAGING_TOKEN=

# Tuning
UPSTREAM_TIMEOUT_S=60
AGENT_TIMEOUT_S=30
AGENT_MAX_INPUT_CHARS=60000
ORIGIN_GENVIZ_LOG=INFO
