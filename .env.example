# Cerebras (required for visualizations; without it the proxy is a passthrough)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=zai-glm-4.7
CEREBRAS_TEMPERATURE=0.2
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Upstream MCP server.
ORIGIN_STAGING_URL=https://mcp.staging.originhq.com/mcp

# Auth — origin-genviz manages its own OAuth. Run `origin-genviz login`
# once to authenticate; tokens persist at $XDG_CONFIG_HOME/origin-genviz/credentials.json
# and are refreshed automatically. Use ORIGIN_STAGING_TOKEN to bypass OAuth
# entirely (static bearer; no refresh).
# ORIGIN_STAGING_TOKEN=
# ORIGIN_GENVIZ_TOKEN_PATH=/path/to/credentials.json
# ORIGIN_GENVIZ_OAUTH_PORT=53217
# ORIGIN_GENVIZ_OAUTH_TIMEOUT_S=300

# Tuning
UPSTREAM_TIMEOUT_S=60
AGENT_TIMEOUT_S=30
AGENT_MAX_INPUT_CHARS=60000
ORIGIN_GENVIZ_LOG=INFO
